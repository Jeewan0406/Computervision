    "@codemirror/view": "^6.43.15",
    "@heyputer/puter.js": "^2.6.5",
    "codemirror": "^6.0.2",
    "docx": "9.15.3",
    "dompurify": "^3.4.18",
    "fflate": "0.8.3",
    "highlight.js": "^11.12.0",
    "html-to-image": "1.11.13",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.10",
